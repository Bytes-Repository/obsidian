pub fn handles_to_types(items: [int]) -> [Type] is
    let mut out: [Type] = []
    let mut i: int = 0
    while i < items.len() is
        let h: int = items[i]
        out.push(Type { handle: h })
        i = i + 1
    end
    return out
end

