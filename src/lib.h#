pub const VERSION: string = "0.1.0"
;; Wersja LLVM, pod którą zbudowana jest TA wersja Obsidian — kolejne
;; wersje LLVM dostają kolejne wersje Obsidian (0.2.x -> LLVM 22, ...),
;; zawsze z identycznym API wysokopoziomowym (Context/Module/Builder/...).
;; Patrz README.md, sekcja "Wersjonowanie".
pub const TARGET_LLVM_VERSION: string = "21"

;; Ostatni komunikat błędu z funkcji "kombinowanych" (Target::from_triple,
;; ExecutionEngine::create_*, TargetMachine::emit_to_file, Module::verify
;; przez `is_valid`/`verify`, ...) — te funkcje już zwracają błąd wprost
;; (przez `nil`/string), więc zwykle NIE musisz tego wołać. Przydaje się
;; głównie do logowania/debugowania.
pub fn last_error() -> string is
    return obsidian_last_error()
end
